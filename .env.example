# Required to encrypt student-owned Gemini API keys at rest (AES-256-GCM).
# Generate once with: openssl rand -hex 32
# Keep this value stable and back it up; changing it makes saved keys unreadable.
GEMINI_KEY_ENCRYPTION_KEY=replace_with_64_hex_characters

# Phase deadlines use this timezone when a student has no explicit timezone.
REPORT_TIMEZONE=Asia/Kolkata

# Optional: overdue phase warning emails remain disabled until SMTP is configured.
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM=Goal Setting App <no-reply@example.com>
